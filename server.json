{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.getscreenshotapi/mcp",
  "title": "GetScreenshot",
  "description": "Screenshot web pages, render HTML and diff captures, with images sized for vision models.",
  "version": "0.1.0",
  "websiteUrl": "https://www.getscreenshotapi.com/agents/",
  "repository": {
    "url": "https://github.com/rasterwise/getscreenshot-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "getscreenshot-mcp",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GETSCREENSHOT_API_KEY",
          "description": "GetScreenshot API key. Get one at https://www.getscreenshotapi.com/#pricing",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.getscreenshotapi.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer token: your GetScreenshot API key. Get one at https://www.getscreenshotapi.com/#pricing",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "GetScreenshot API key",
              "format": "string",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
